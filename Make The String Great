#include <stdlib.h>

char* makeGood(char* s) {
    int i = 0;
    int top = -1;
    
    while (s[i] != '\0') {
        if (top >= 0 && (s[top] - s[i] == 32 || s[i] - s[top] == 32)) {
            top--;
        } else {
            top++;
            s[top] = s[i];
        }
        i++;
    }
    
    s[top + 1] = '\0';
    return s;
}
