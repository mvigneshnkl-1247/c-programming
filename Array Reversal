#include <stdio.h>
#include <stdlib.h>

int main() {
    int n;
    // Read the size of the array
    scanf("%d", &n);
    
    // Dynamically allocate memory for the array
    int *arr = (int*)malloc(n * sizeof(int));
    
    // Read the array elements
    for(int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
    
    // Print the elements in reverse order
    for(int i = n - 1; i >= 0; i--) {
        printf("%d ", arr[i]);
    }
    
    // Free the allocated memory
    free(arr);
    
    return 0;
}
