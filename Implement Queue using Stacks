#include <stdbool.h>
#include <stdlib.h>

// Standard Stack implementation structure
typedef struct {
    int* data;
    int top;
    int capacity;
} Stack;

Stack* createStack(int capacity) {
    Stack* s = (Stack*)malloc(sizeof(Stack));
    s->data = (int*)malloc(capacity * sizeof(int));
    s->top = -1;
    s->capacity = capacity;
    return s;
}

void push(Stack* s, int val) {
    s->data[++(s->top)] = val;
}

int pop(Stack* s) {
    return s->data[(s->top)--];
}

int peek(Stack* s) {
    return s->data[s->top];
}

bool isStackEmpty(Stack* s) {
    return s->top == -1;
}

void freeStack(Stack* s) {
    free(s->data);
    free(s);
}

// --- MyQueue Definition using Two Stacks ---

typedef struct {
    Stack* stackIn;
    Stack* stackOut;
} MyQueue;

MyQueue* myQueueCreate() {
    MyQueue* queue = (MyQueue*)malloc(sizeof(MyQueue));
    // Up to 100 calls allowed by constraints
    queue->stackIn = createStack(110);
    queue->stackOut = createStack(110);
    return queue;
}

void myQueuePush(MyQueue* obj, int x) {
    // Always push into stackIn -> O(1)
    push(obj->stackIn, x);
}

// Private helper to move elements from stackIn to stackOut when stackOut is empty
void shiftStacks(MyQueue* obj) {
    if (isStackEmpty(obj->stackOut)) {
        while (!isStackEmpty(obj->stackIn)) {
            push(obj->stackOut, pop(obj->stackIn));
        }
    }
}

int myQueuePop(MyQueue* obj) {
    shiftStacks(obj);
    // Pop from stackOut -> Amortized O(1)
    return pop(obj->stackOut);
}

int myQueuePeek(MyQueue* obj) {
    shiftStacks(obj);
    // Peek at stackOut -> Amortized O(1)
    return peek(obj->stackOut);
}

bool myQueueEmpty(MyQueue* obj) {
    // Queue is empty only if both stacks are empty
    return isStackEmpty(obj->stackIn) && isStackEmpty(obj->stackOut);
}

void myQueueFree(MyQueue* obj) {
    freeStack(obj->stackIn);
    freeStack(obj->stackOut);
    free(obj);
}

