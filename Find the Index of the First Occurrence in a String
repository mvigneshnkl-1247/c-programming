#include <string.h>

int strStr(char* haystack, char* needle) {
    int hLen = strlen(haystack);
    int nLen = strlen(needle);
    
    // If the needle is an empty string, the match happens at index 0
    if (nLen == 0) return 0;
    
    // If haystack is shorter than needle, it can't contain it
    if (hLen < nLen) return -1;
    
    // Loop through haystack up to the last possible starting position
    for (int i = 0; i <= hLen - nLen; i++) {
        int j = 0;
        
        // Check if characters match
        while (j < nLen && haystack[i + j] == needle[j]) {
            j++;
        }
        
        // If we matched the entire needle, return the start index
        if (j == nLen) {
            return i;
        }
    }
    
    // Needle not found
    return -1;
}
