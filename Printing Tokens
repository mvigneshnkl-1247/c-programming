#include <stdio.h>
#include <string.h>
#include <stdlib.h>

int main() {
    char *s;
    s = malloc(1025 * sizeof(char));
    
    // Read the entire line until a newline character is encountered
    if (scanf("%[^\n]", s) == 1) {
        // Loop through each character of the string
        for (int i = 0; s[i] != '\0'; i++) {
            if (s[i] == ' ') {
                printf("\n");
            } else {
                printf("%c", s[i]);
            }
        }
        printf("\n");
    }
    
    free(s);
    return 0;
}
