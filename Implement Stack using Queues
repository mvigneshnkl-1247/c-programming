#include <stdbool.h>
#include <stdlib.h>

// Standard Queue implementation structure
typedef struct {
    int* data;
    int front;
    int rear;
    int size;
    int capacity;
} Queue;

Queue* createQueue(int capacity) {
    Queue* q = (Queue*)malloc(sizeof(Queue));
    q->data = (int*)malloc(capacity * sizeof(int));
    q->front = 0;
    q->rear = -1;
    q->size = 0;
    q->capacity = capacity;
    return q;
}

void enqueue(Queue* q, int val) {
    q->rear = (q->rear + 1) % q->capacity;
    q->data[q->rear] = val;
    q->size++;
}

int dequeue(Queue* q) {
    int val = q->data[q->front];
    q->front = (q->front + 1) % q->capacity;
    q->size--;
    return val;
}

int peekQueue(Queue* q) {
    return q->data[q->front];
}

bool isQueueEmpty(Queue* q) {
    return q->size == 0;
}

void freeQueue(Queue* q) {
    free(q->data);
    free(q);
}

// --- MyStack Definition using Two Queues ---

typedef struct {
    Queue* q1;
    Queue* q2;
} MyStack;

MyStack* myStackCreate() {
    MyStack* stack = (MyStack*)malloc(sizeof(MyStack));
    // Maximum 100 operations as per constraints
    stack->q1 = createQueue(110);
    stack->q2 = createQueue(110);
    return stack;
}

void myStackPush(MyStack* obj, int x) {
    // 1. Enqueue the new element to the auxiliary queue q2
    enqueue(obj->q2, x);
    
    // 2. Move all elements from q1 to q2
    while (!isQueueEmpty(obj->q1)) {
        enqueue(obj->q2, dequeue(obj->q1));
    }
    
    // 3. Swap q1 and q2 so that q1 always holds the stack elements
    Queue* temp = obj->q1;
    obj->q1 = obj->q2;
    obj->q2 = temp;
}

int myStackPop(MyStack* obj) {
    // Top element is always at the front of q1
    return dequeue(obj->q1);
}

int myStackTop(MyStack* obj) {
    // Peek at the front of q1
    return peekQueue(obj->q1);
}

bool myStackEmpty(MyStack* obj) {
    return isQueueEmpty(obj->q1);
}

void myStackFree(MyStack* obj) {
    freeQueue(obj->q1);
    freeQueue(obj->q2);
    free(obj);
}

