#include <stdio.h>
#include <string.h>

int lengthOfLongestSubstring(char* s) {
    int len = strlen(s);
    if (len == 0) return 0;

    // Array to store the last seen index of each ASCII character, initialized to -1
    int last_seen[128];
    memset(last_seen, -1, sizeof(last_seen));

    int max_len = 0;
    int left = 0;

    for (int right = 0; right < len; right++) {
        char current_char = s[right];

        // If the character was seen inside the current window, move the left pointer
        if (last_seen[(unsigned char)current_char] >= left) {
            left = last_seen[(unsigned char)current_char] + 1;
        }

        // Update the last seen position of the current character
        last_seen[(unsigned char)current_char] = right;

        // Calculate the current window size and update max_len
        int current_len = right - left + 1;
        if (current_len > max_len) {
            max_len = current_len;
        }
    }

    return max_len;
}
