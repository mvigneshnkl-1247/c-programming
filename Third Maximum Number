#include <stdio.h>
#include <limits.h>

int thirdMax(int* nums, int numsSize) {
    // Use long long initialized to the lowest possible value to handle INT_MIN safely
    long long max1 = LLONG_MIN;
    long long max2 = LLONG_MIN;
    long long max3 = LLONG_MIN;

    for (int i = 0; i < numsSize; i++) {
        long long current = nums[i];

        // Skip if the current number matches any of our existing distinct maximums
        if (current == max1 || current == max2 || current == max3) {
            continue;
        }

        // Cascade shifts if a new maximum is found
        if (current > max1) {
            max3 = max2;
            max2 = max1;
            max1 = current;
        } else if (current > max2) {
            max3 = max2;
            max2 = current;
        } else if (current > max3) {
            max3 = current;
        }
    }

    // If max3 was never updated, the third distinct maximum doesn't exist.
    // In that case, return the absolute maximum (max1).
    if (max3 == LLONG_MIN) {
        return (int)max1;
    }

    return (int)max3;
}
