char* reversePrefix(char* word, char ch) {
    int len = strlen(word);
    char* ans = (char*)malloc((len + 1) * sizeof(char));
    int idx = 0;
    for (int i =0; i<len; i++){
        if (word[i] == ch){
            idx = i;
            break;
        }
    }
    int pos = 0; 
    for (int j = idx; j >= 0; j--){
        ans[pos++] = word[j];
    }
    for (int k=idx +1; k < len; k++){
        ans[pos++] = word[k];
    }
    ans[pos] = '\0';
    return ans;
}
