#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main() {

    char s[1001];
    
    // Read the input string
    if (scanf("%1000s", s) != 1) {
        return 0;
    }
    
    // Initialize frequency array for digits 0-9 to zero
    int freq[10] = {0};
    
    // Count occurrences of each digit
    for (int i = 0; s[i] != '\0'; i++) {
        if (s[i] >= '0' && s[i] <= '9') {
            freq[s[i] - '0']++;
        }
    }
    
    // Print the frequencies separated by spaces
    for (int i = 0; i < 10; i++) {
        printf("%d", freq[i]);
        if (i < 9) {
            printf(" ");
        }
    }
    printf("\n");
    
    return 0;
}
